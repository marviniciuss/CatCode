[node name="Instructions" type="Label" parent="HowToPlayModal/Card/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.1, 0.3, 1)
theme_override_font_sizes/font_size = 14
text = "1. Você programa as ações do robô assistente do abrigo.
2. Clique nos blocos da paleta para adicioná-los à lista.
3. Guie o robô desviando dos arbustos e caixas.
4. Ao chegar na tigela de ração, use o comando COLETAR.
5. Em seguida, leve a comida até o animal e use ALIMENTAR!
6. Pressione o botão ▶ para ver o robô executar o algoritmo."
autowrap_mode = 2

